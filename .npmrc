engine-strict=true
# Upstream Pi manifests pin each other with exact versions ("1.2.0"). Link those
# to the vendored workspace packages instead of resolving a registry copy.
link-workspace-packages=true
prefer-workspace-packages=true
# pi-ai imports types from @smithy/types without declaring it; upstream npm
# hoisting provides it through @aws-sdk/client-bedrock-runtime. See OB-DEP-1 in
# third_party/pi/OPENBOT_CHANGES.md.
public-hoist-pattern[]=@smithy/types
