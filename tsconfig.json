{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true
	},
	"include": [
		"apps/*/src/**/*.ts",
		"apps/*/test/**/*.ts",
		"packages/*/src/**/*.ts",
		"packages/*/test/**/*.ts",
		"e2e/**/*.ts",
		"scripts/acceptance/lib/**/*.ts",
		"scripts/acceptance/radar-pagination-audit.mts",
		"scripts/test/**/*.ts"
	],
	// Desktop is bundled by electron-vite and type-checks with bundler resolution in apps/desktop/tsconfig.json.
	"exclude": ["apps/desktop/**"]
}
